<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!--
      Required to consume the internal AdviceCommittedPendingEvents<T>. src/* assemblies are
      strong-named and grant friendship with a Key=, so an unsigned test assembly fails the
      identity check and the InternalsVisibleTo silently does not apply.
    -->
    <SignAssembly>true</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Schemata.Entity.Event\Schemata.Entity.Event.csproj" />
    <ProjectReference Include="..\..\src\Schemata.Entity.Repository\Schemata.Entity.Repository.csproj" />
    <ProjectReference Include="..\..\src\Schemata.Event.Skeleton\Schemata.Event.Skeleton.csproj" />
  </ItemGroup>

</Project>
