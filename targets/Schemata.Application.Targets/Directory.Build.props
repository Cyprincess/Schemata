<Project>

  <Import Project="$(MSBuildThisFileDirectory)..\..\Directory.Build.props" />

  <!--
    Variant-independent defaults only. Variant-dependent items (Use* composition
    switches) are composed in the single family owner, Directory.Build.targets.
  -->

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Schemata.Core\Schemata.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\artifacts\bin\Schemata.Advice.Generator\$(Configuration)\netstandard2.0\Schemata.Advice.Generator.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)_._" Pack="true" PackagePath="lib/net8.0" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)_._" Pack="true" PackagePath="lib/net10.0" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\generators\Schemata.Advice.Generator\Schemata.Advice.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
